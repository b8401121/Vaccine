{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桃園 吳鎮宇親子耳鼻喉科診所 ‧ 預防接種指南助手",
  "version": "0.1.0",
  "identifier": "com.tauri.vaccine.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "桃園 吳鎮宇親子耳鼻喉科診所 ‧ 預防接種指南助手",
        "width": 1000,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
